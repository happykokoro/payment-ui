{
  "name": "payment-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional customer checkout and merchant dashboard for Payment Core",
  "license": "MIT",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "tsx --env-file=.env server/main.ts",
    "dev:assets": "vite build --watch",
    "build": "tsc -p server/tsconfig.json && vite build",
    "start": "node --env-file=.env dist/server/main.js",
    "check": "tsc --noEmit -p server/tsconfig.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:checkout": "tsx test/checkout.browser.ts",
    "test:browser": "tsx test/checkout.browser.ts",
    "keys": "node scripts/keys.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/secure-session": "^8.4.1",
    "@fastify/static": "^10.1.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.7",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.10",
    "wagmi": "^3.7.9",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
