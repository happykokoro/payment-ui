{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./shared/*"
      ]
    }
  },
  "include": [
    "checkout/src/**/*",
    "dashboard/src/**/*",
    "shared/**/*.ts",
    "shared/**/*.tsx"
  ]
}
